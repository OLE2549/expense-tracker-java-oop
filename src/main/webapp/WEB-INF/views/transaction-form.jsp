<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %><%@ page import="com.finance.model.Transaction,java.time.LocalDate" %>
<% Transaction item=(Transaction)request.getAttribute("item"); boolean editing=item!=null; String ctx=request.getContextPath(); %>
<!DOCTYPE html><html lang="th"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1"><title><%= editing?"แก้ไขรายการ":"เพิ่มรายการ" %> | MyPocket</title><link rel="stylesheet" href="<%=ctx%>/assets/style.css"></head><body class="form-bg"><main class="form-page"><a class="back-link" href="<%=ctx%>/dashboard">← กลับไป Dashboard</a><section class="form-card"><p class="eyebrow">จัดการธุรกรรม</p><h1><%= editing?"แก้ไขรายการ":"เพิ่มรายการใหม่" %></h1><p class="muted">กรอกรายละเอียดรายการทางการเงินของคุณ</p>
<% if(request.getAttribute("error")!=null){ %><div class="alert"><%= request.getAttribute("error") %></div><% } %>
<form method="post" action="<%=ctx%>/transactions"><% if(editing){ %><input type="hidden" name="id" value="<%=item.getId()%>"><% } %>
<label>ประเภท</label><div class="type-select"><label class="choice"><input type="radio" name="type" value="INCOME" <%=!editing||"INCOME".equals(item.getType())?"checked":""%>> รายรับ</label><label class="choice"><input type="radio" name="type" value="EXPENSE" <%=editing&&"EXPENSE".equals(item.getType())?"checked":""%>> รายจ่าย</label></div>
<label for="title">ชื่อรายการ</label><input id="title" name="title" maxlength="150" required value="<%=editing?esc(item.getTitle()):""%>" placeholder="เช่น เงินเดือน / ค่าอาหาร">
<label for="amount">จำนวนเงิน (บาท)</label><input id="amount" type="number" name="amount" min="0.01" step="0.01" required value="<%=editing?item.getAmount().toPlainString():""%>" placeholder="0.00">
<label for="category">หมวดหมู่</label><select id="category" name="category" required><% String cat=editing?item.getCategory():""; String[] cats={"เงินเดือน","งานเสริม","อาหาร","เดินทาง","ช้อปปิ้ง","บิลและสาธารณูปโภค","สุขภาพ","การศึกษา","อื่น ๆ"}; %><% for(String c:cats){ %><option value="<%=c%>" <%=c.equals(cat)?"selected":""%>><%=c%></option><% } if(!cat.isEmpty() && java.util.Arrays.stream(cats).noneMatch(cat::equals)){ %><option selected value="<%=esc(cat)%>"><%=esc(cat)%></option><% } %></select>
<label for="transactionDate">วันที่</label><input id="transactionDate" type="date" name="transactionDate" required value="<%=editing?item.getTransactionDate():LocalDate.now()%>">
<label for="note">หมายเหตุ (ไม่บังคับ)</label><textarea id="note" name="note" rows="3" maxlength="500" placeholder="รายละเอียดเพิ่มเติม"><%=editing?esc(item.getNote()==null?"":item.getNote()):""%></textarea>
<div class="form-actions"><a class="btn light" href="<%=ctx%>/dashboard">ยกเลิก</a><button class="btn primary"><%=editing?"บันทึกการแก้ไข":"บันทึกรายการ"%></button></div></form></section></main></body></html>
<%! private String esc(String s){if(s==null)return "";return s.replace("&","&amp;").replace("<","&lt;").replace(">","&gt;").replace("\"","&quot;").replace("'","&#39;");} %>