<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %><%@ page import="com.finance.model.User,com.finance.model.Transaction,java.text.NumberFormat,java.util.Locale" %><%@ taglib prefix="c" uri="jakarta.tags.core" %>
<% User user=(User)session.getAttribute("user"); NumberFormat money=NumberFormat.getNumberInstance(new Locale("th","TH")); money.setMinimumFractionDigits(2); money.setMaximumFractionDigits(2); %>
<!DOCTYPE html><html lang="th"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1"><title>Dashboard | MyPocket</title><link rel="stylesheet" href="${pageContext.request.contextPath}/assets/style.css"><script src="https://cdn.jsdelivr.net/npm/chart.js"></script></head>
<body><div class="app-shell"><aside class="sidebar"><a class="brand" href="${pageContext.request.contextPath}/dashboard"><span class="brand-mark small">฿</span> MyPocket</a><nav><a class="nav active" href="${pageContext.request.contextPath}/dashboard">▦ &nbsp; ภาพรวม</a><a class="nav" href="${pageContext.request.contextPath}/transactions">＋ &nbsp; เพิ่มรายการ</a></nav><div class="sidebar-bottom"><div class="avatar"><%= user.getFullName().substring(0,1).toUpperCase() %></div><div class="user-meta"><strong><%= user.getFullName() %></strong><small><%= user.getEmail() %></small></div><form method="post" action="${pageContext.request.contextPath}/logout"><button class="logout" title="ออกจากระบบ">ออก</button></form></div></aside>
<main class="main"><header class="topbar"><div><p class="eyebrow">ภาพรวมการเงิน</p><h1>สวัสดี, <%= user.getFullName() %> 👋</h1><p class="muted">มาดูภาพรวมการเงินของคุณกัน</p></div><a class="btn primary" href="${pageContext.request.contextPath}/transactions">＋ เพิ่มรายการ</a></header>
<% if(session.getAttribute("flash")!=null){ %><div class="success"><%= session.getAttribute("flash") %></div><% session.removeAttribute("flash"); } %>
<form class="filter-row" method="get" action="${pageContext.request.contextPath}/dashboard"><label for="month">สรุปประจำเดือน</label><input id="month" type="month" name="month" value="${selectedMonth}"><button class="btn light">แสดงผล</button></form>
<section class="summary-grid"><article class="summary-card balance"><div class="card-top"><span>เงินสุทธิของเดือนนี้</span><span class="icon-pill">฿</span></div><strong>฿ <%= money.format(((java.math.BigDecimal)request.getAttribute("balance")).doubleValue()) %></strong><small>รายรับลบรายจ่าย</small></article>
<article class="summary-card"><div class="card-top"><span>รายรับทั้งหมด</span><span class="icon-pill green">↗</span></div><strong class="green-text">฿ <%= money.format(((java.math.BigDecimal)request.getAttribute("income")).doubleValue()) %></strong><small>เดือนที่เลือก</small></article>
<article class="summary-card"><div class="card-top"><span>รายจ่ายทั้งหมด</span><span class="icon-pill red">↘</span></div><strong class="red-text">฿ <%= money.format(((java.math.BigDecimal)request.getAttribute("expense")).doubleValue()) %></strong><small>เดือนที่เลือก</small></article></section>
<section class="content-grid"><article class="panel chart-panel"><div class="panel-heading"><div><h2>รายรับและรายจ่าย</h2><p class="muted">เปรียบเทียบรายเดือนในปีปัจจุบัน</p></div></div><canvas id="moneyChart" height="115"></canvas></article><article class="panel"><div class="panel-heading"><div><h2>เคล็ดลับการเงิน</h2><p class="muted">สร้างนิสัยการเงินที่ดี</p></div></div><div class="tip"><span>✦</span><div><strong>จดทุกธุรกรรม</strong><p>บันทึกรายการทันทีเพื่อให้ข้อมูลแม่นยำ</p></div></div><div class="tip"><span>◎</span><div><strong>ทบทวนทุกสิ้นเดือน</strong><p>เปรียบเทียบรายจ่ายเพื่อวางแผนเดือนถัดไป</p></div></div></article></section>
<section class="panel transactions-panel"><div class="panel-heading"><div><h2>รายการล่าสุด</h2><p class="muted">ธุรกรรมในเดือนที่เลือก</p></div></div><div class="table-wrap"><table><thead><tr><th>รายการ</th><th>หมวดหมู่</th><th>วันที่</th><th>ประเภท</th><th class="right">จำนวนเงิน</th><th>จัดการ</th></tr></thead><tbody>
<c:forEach var="t" items="${transactions}"><tr><td><strong><c:out value="${t.title}"/></strong><c:if test="${not empty t.note}"><small class="table-note"><c:out value="${t.note}"/></small></c:if></td><td><span class="category"><c:out value="${t.category}"/></span></td><td>${t.transactionDate}</td><td><c:choose><c:when test="${t.type == 'INCOME'}"><span class="type income">รายรับ</span></c:when><c:otherwise><span class="type expense">รายจ่าย</span></c:otherwise></c:choose></td><td class="right amount"><c:choose><c:when test="${t.type == 'INCOME'}"><span class="green-text">+ ฿ <c:out value="${t.amount}"/></span></c:when><c:otherwise><span class="red-text">− ฿ <c:out value="${t.amount}"/></span></c:otherwise></c:choose></td><td><div class="actions"><a href="${pageContext.request.contextPath}/transactions?action=edit&id=${t.id}">แก้ไข</a><form method="post" action="${pageContext.request.contextPath}/transactions" onsubmit="return confirm('ยืนยันการลบรายการนี้?')"><input type="hidden" name="action" value="delete"><input type="hidden" name="id" value="${t.id}"><button class="link-danger">ลบ</button></form></div></td></tr></c:forEach>
<c:if test="${empty transactions}"><tr><td colspan="6" class="empty">ยังไม่มีรายการในเดือนนี้ <a href="${pageContext.request.contextPath}/transactions">เพิ่มรายการแรก</a></td></tr></c:if>
</tbody></table></div></section><footer>MyPocket · จัดการเงินอย่างเข้าใจง่าย</footer></main></div>
<script>
const labels = "${chartLabels}".split(",");
const incomes = "${chartIncomes}".split(",").map(Number);
const expenses = "${chartExpenses}".split(",").map(Number);
new Chart(document.getElementById('moneyChart'), {type:'bar',data:{labels,datasets:[{label:'รายรับ',data:incomes,backgroundColor:'#22a06b',borderRadius:6},{label:'รายจ่าย',data:expenses,backgroundColor:'#f07878',borderRadius:6}]},options:{responsive:true,plugins:{legend:{position:'bottom'}},scales:{y:{beginAtZero:true,grid:{color:'#edf0f5'}},x:{grid:{display:false}}}}});
</script></body></html>